<?xml version="1.0"?>
<sdf version="1.7">
  <world name="happy_care_room">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 2</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 2</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 2</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="furniture_table">
      <static>true</static>
      <pose>1.5 -1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 0.6 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 0.6 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="charging_station">
      <static>true</static>
      <pose>-2 2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.3</size></box></geometry>
          <material><ambient>0.1 0.6 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="person">
      <pose>0 0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.9 0.7 0.5 1</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
